datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model User {
  id              String          @id @default(uuid())
  name            String
  username        String          @unique
  passwordHash    String
  role            String          // "ADMIN" | "PROFESSOR" | "STUDENT"
  cabinNumber     Int?            @unique
  isActive        Boolean         @default(true)
  consentGivenAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sessions        Session[]
  recordings      Recording[]     @relation("RecordedBy")
  studentRecords  Recording[]     @relation("StudentRecord")
  monitoringLogsAsProf    MonitoringLog[] @relation("ProfLogs")
  monitoringLogsAsStudent MonitoringLog[] @relation("StudentLogs")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt     DateTime  @default(now())
  logoutAt    DateTime?
  deviceInfo  String?
  ipAddress   String?
}

model Call {
  id            String    @id @default(uuid())
  roomId        String    @unique
  type          String    // "ONE_TO_ONE_VIDEO" | "ONE_TO_ONE_AUDIO" | "GROUP_VIDEO" | "GROUP_AUDIO"
  initiatedBy   String
  participants  String    // JSON array of user IDs
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  durationSec   Int?

  recordings    Recording[]
}

model Recording {
  id            String    @id @default(uuid())
  title         String
  relatedCallId String?
  call          Call?     @relation(fields: [relatedCallId], references: [id])
  studentId     String?
  student       User?     @relation("StudentRecord", fields: [studentId], references: [id])
  recordedBy    String
  professor     User      @relation("RecordedBy", fields: [recordedBy], references: [id])
  filePath      String
  durationSec   Int       @default(0)
  sizeBytes     Int       @default(0)
  mimeType      String    @default("video/webm")
  createdAt     DateTime  @default(now())
}

// A student identity that is independent of the shared cabin login:
// the same Roll No + PIN works from any cabin, on any day.
model Learner {
  id              String             @id @default(uuid())
  rollNo          String             @unique
  name            String
  pinHash         String
  failedAttempts  Int                @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime           @default(now())

  recordings      StudentRecording[]
}

// A student's own voice recording (pronunciation practice).
model StudentRecording {
  id           String    @id @default(uuid())
  learnerId    String
  learner      Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  cabinNumber  Int?
  title        String
  filePath     String    // absolute path on disk, never served statically
  mimeType     String    @default("audio/webm")
  durationSec  Int       @default(0)
  sizeBytes    Int       @default(0)
  recordedAt   DateTime  @default(now())
  status       String    @default("DRAFT") // "DRAFT" | "SUBMITTED" | "GRADED"
  submittedAt  DateTime?
  marks        Float?
  maxMarks     Int       @default(10)
  remark       String?
  gradedAt     DateTime?
  gradedById   String?
  locked       Boolean   @default(false)
}

// Audio/video the professor uploads or records for the class.
model MediaItem {
  id           String       @id @default(uuid())
  title        String
  filePath     String       // absolute path on disk
  mimeType     String
  kind         String       // "AUDIO" | "VIDEO"
  source       String       @default("UPLOAD") // "UPLOAD" | "PROF_RECORDING"
  durationSec  Int          @default(0)
  sizeBytes    Int          @default(0)
  createdById  String
  createdAt    DateTime     @default(now())

  shares       MediaShare[]
}

// Which cabins can see a MediaItem (persists across reconnects/logins).
model MediaShare {
  id           String    @id @default(uuid())
  mediaId      String
  media        MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  targetType   String    // "ALL" | "CABINS"
  cabins       String    @default("[]") // JSON array of cabin numbers
  mode         String    @default("student") // "student" | "synced"
  active       Boolean   @default(true)
  createdById  String
  createdAt    DateTime  @default(now())
}

model MonitoringLog {
  id            String    @id @default(uuid())
  professorId   String
  professor     User      @relation("ProfLogs", fields: [professorId], references: [id])
  studentId     String
  student       User      @relation("StudentLogs", fields: [studentId], references: [id])
  action        String    // "SCREEN_VIEW" | "AUDIO_LISTEN" | "WEBCAM_VIEW"
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
}
